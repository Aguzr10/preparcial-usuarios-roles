# Copia este archivo como .env y pon tus propios valores.
# docker-compose.yml también lee estas variables para crear la base.

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5435
DB_USER=tu_usuario
DB_PASS=tu_contrasena
DB_NAME=usuarios_roles_db

# JWT (genera el secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=cambia-esto-por-64-caracteres-hex-aleatorios
JWT_EXPIRES_IN=2m
JWT_REFRESH_EXPIRES_IN=7d
